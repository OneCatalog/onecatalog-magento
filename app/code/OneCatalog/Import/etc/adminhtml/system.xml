<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="onecatalog" translate="label" sortOrder="400">
            <label>OneCatalog</label>
        </tab>
        <section id="onecatalog" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>OneCatalog Import</label>
            <tab>onecatalog</tab>
            <resource>OneCatalog_Import::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="api_base" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Wiki API base URL</label></field>
                <field id="api_token" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>API token</label><comment>X-API-Key for Wiki API and the picker widget.</comment></field>
                <field id="lang" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Product language</label><comment>e.g. en, ru</comment></field>
                <field id="step" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Import step (batch size)</label><comment>Minimum 10.</comment></field>
                <field id="new_active" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>New product status (enabled)</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="picker_base" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Picker base URL</label></field>
            </group>
            <group id="references" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Reference entities (off by default; native-first)</label>
                <field id="import_brand" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>Import brand (→ native Manufacturer)</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="import_tags" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Import tags (→ attribute)</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="import_country" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Import country (→ attribute)</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="import_collections" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Import collections</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="collection_target" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Collections target</label><source_model>OneCatalog\Import\Model\Config\Source\CollectionTarget</source_model></field>
            </group>
            <group id="b2b" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>B2B — prices &amp; stock (§13)</label>
                <field id="base" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1"><label>B2B API base URL</label></field>
                <field id="url_key" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Retailer key (url_key)</label></field>
                <field id="private_key" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Private key</label></field>
                <field id="strategy" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Price strategy</label><source_model>OneCatalog\Import\Model\Config\Source\B2bStrategy</source_model></field>
                <field id="region_priority" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Region priority (ids, comma)</label></field>
                <field id="supplier_priority" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1"><label>Supplier priority (ids, comma)</label></field>
                <field id="supplier_fixed" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Fixed supplier id</label></field>
                <field id="promo_as_sale" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1"><label>Promo as special price</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
                <field id="manage_stock" translate="label" type="select" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1"><label>Manage stock</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
            </group>
        </section>
    </system>
</config>
